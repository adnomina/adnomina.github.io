---
import BaseHead from "../components/BaseHead.astro";
import Footer from "../components/Footer.astro";
import Header from "../components/Header.astro";
import { SITE_DESCRIPTION, SITE_TITLE } from "../consts";
---

<!doctype html>
<html lang="en">
  <head>
    <BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
  </head>
  <body>
    <Header />
    <main>
      <h1>Hello, stranger!</h1>
      <p>
        Welcome to my website. My name is Nicolas and I'm a Software Engineer
        from Germany. On the web I go by adnomina.
      </p>
      <p>
        Some useful links:
        <ul>
          <li>
            <a href="/about">About</a>
          </li>
          <li>
            <a href="/blog">Blog</a>
          </li>
          <li>
            <a href="/chips">Chips</a> -- a format inspired by Martin Fowler's{" "}
            <a href="https://martinfowler.com/fragments/" target="_blank">
              fragments
            </a>
            {"."}
          </li>
          <li>
            <a href="https://github.com/adnomina" target="_blank">
              GitHub
            </a>
          </li>
        </ul>
      </p>
      <p>Enjoy your stay!</p>
    </main>
    <Footer />
  </body>
</html>
